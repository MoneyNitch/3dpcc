# Port, auf dem der Server läuft (Standard: 3000)
# PORT=3000

# Login und Rollenpruefung (Standard: true). false = ungeschuetzte lokale Anwendung.
# Erstes Konto: admin/admin mit Superadmin-Rechten; Benutzername und Passwort
# muessen vor weiterer Nutzung geaendert werden (neues Passwort: 12-128 Zeichen).
AUTH_ENABLED=true
# Bei HTTPS vor einem Reverse Proxy einschalten:
# AUTH_COOKIE_SECURE=true
# Oeffentliche Browser-Origin bei Reverse Proxy, exakt inkl. Port (ohne Pfad):
# AUTH_ORIGIN=https://3dpcc.example.com
# Diese Werte aktivieren TLS nicht selbst: Zertifikat und HTTPS-Listener
# am Reverse Proxy konfigurieren. HTTP auf HTTPS umleiten und direkten
# Zugriff auf den internen App-Port sperren. Danach den App-Server neu starten.

# Versionierte REST-API und geschuetzte OpenAPI-Ansicht unter /api/v1/docs.
# Mit Login: benutzergebundene Schluessel in der Benutzerverwaltung erstellen.
# API_KEYS gelten nur bei AUTH_ENABLED=false. Ohne Keys dann HTTP 503.
# Kommagetrennte Keys, jeweils 32-256 Zeichen: A-Z, a-z, 0-9, _ und -.
# Lokal erzeugen: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# API_KEYS=

# Optional: harte Limits mit docker-compose.limits.yml (gesamter Container).
# Fuer Compose in .env setzen, nicht in .env.local.
# Ohne Wert (oder mit 0) bleibt die jeweilige Ressource unbegrenzt.
# APP_CPUS=1.0
# APP_MEMORY=2g

# Datenbank-Backend: sqlite (Standard, lokale Datei) | postgres | mysql (auch für MariaDB)
DB_DRIVER=sqlite

# Nur für DB_DRIVER=postgres oder DB_DRIVER=mysql/mariadb erforderlich:
# Postgres-Beispiel: postgres://user:password@localhost:5432/3dpcc
# MySQL/MariaDB-Beispiel: mysql://user:password@localhost:3306/3dpcc
# DATABASE_URL=
