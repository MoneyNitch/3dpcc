# Port, auf dem der Server läuft (Standard: 3000)
# PORT=3000

# Versionierte REST-API und geschuetzte OpenAPI-Ansicht unter /api/v1/docs.
# Ohne API_KEYS bleibt die neue API deaktiviert (HTTP 503).
# Kommagetrennte Keys, jeweils 32-256 Zeichen: A-Z, a-z, 0-9, _ und -.
# Lokal erzeugen: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# API_KEYS=

# Optional: harte Limits mit docker-compose.limits.yml (gesamter Container).
# Fuer Compose in .env setzen, nicht in .env.local.
# Ohne Wert (oder mit 0) bleibt die jeweilige Ressource unbegrenzt.
# APP_CPUS=1.0
# APP_MEMORY=2g

# Datenbank-Backend: sqlite (Standard, lokale Datei) | postgres | mysql (auch für MariaDB)
DB_DRIVER=sqlite

# Nur für DB_DRIVER=postgres oder DB_DRIVER=mysql/mariadb erforderlich:
# Postgres-Beispiel: postgres://user:password@localhost:5432/3dpcc
# MySQL/MariaDB-Beispiel: mysql://user:password@localhost:3306/3dpcc
# DATABASE_URL=
